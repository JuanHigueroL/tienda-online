# Dependencias (Carpeta muy pesada que se regenera con npm install)
node_modules/

# Archivos de entorno y configuración sensible
.env

# Archivos de registro de errores
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos del sistema operativo
Thumbs.db
.DS_Store

# Archivos de configuración de IDEs (Opcional, pero recomendado)
.vscode/
.idea/